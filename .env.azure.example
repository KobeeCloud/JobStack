# ─────────────────────────────────────────────────────────────────────────────
# .env.azure.example — Environment variables for Azure self-hosted deployment
#
# At runtime, these are fetched from Azure Key Vault via Managed Identity.
# Copy this to .env and fill in values, OR use the Ansible app-setup playbook
# which pulls from Key Vault automatically.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://jobstack.kobecloud.pl

# ── Azure PostgreSQL Flexible Server ─────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
# Key Vault secret: pg-connection-string
POSTGRES_URL=postgresql://pgadmin:YOUR_PASSWORD@pg-jobstack-prod.postgres.database.azure.com:5432/jobstack?sslmode=require

# ── Azure Cache for Redis ────────────────────────────────────────────────────
# Key Vault secret: redis-primary-key
AZURE_REDIS_HOST=redis-jobstack-prod.redis.cache.windows.net
AZURE_REDIS_PORT=6380
AZURE_REDIS_PASSWORD=YOUR_REDIS_PRIMARY_KEY
AZURE_REDIS_TLS=true

# ── Supabase (Auth only — keep using Supabase Cloud for auth for now) ────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Azure Blob Storage (replaces Supabase Storage) ───────────────────────────
AZURE_STORAGE_ACCOUNT_NAME=stjobstackprodapp
AZURE_STORAGE_CONTAINER_UPLOADS=uploads
AZURE_STORAGE_CONTAINER_EXPORTS=exports

# ── Azure Key Vault ──────────────────────────────────────────────────────────
AZURE_KEY_VAULT_NAME=kv-jobstack-prod
AZURE_CLIENT_ID=your_managed_identity_client_id  # From terraform output

# ── Error Tracking (Sentry — keep as SaaS) ──────────────────────────────────
SENTRY_DSN=your_sentry_dsn_here

# ── Application Insights ─────────────────────────────────────────────────────
# Key Vault secret: applicationinsights-connection-string
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxx...

# ── Email (Resend — keep as SaaS) ────────────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── AI (OpenAI — keep as SaaS) ───────────────────────────────────────────────
OPENAI_API_KEY=sk-your_openai_key

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
